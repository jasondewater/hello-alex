# Hello Alex Starter Kit - .gitignore
# Generic ignores for Node.js, Firebase, Python projects

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock
pnpm-lock.yaml

# Python
__pycache__/
*.py[cod]
*$py.class
venv/
env/
.Python
.env

# Build outputs
dist/
build/
*.log
*.pid
*.seed
*.pid.lock

# Firebase
.firebase/
firebase-debug.log*
firestore-debug.log*
database-debug.log*
ui-debug.log*
emulators.log

# Environment variables
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Test coverage
coverage/
.nyc_output/
*.lcov

# Logs
logs
*.log

# Temporary files
tmp/
temp/
*.tmp

# Credentials (NEVER commit these!)
serviceAccountKey.json
*-key.json
credentials.json
secrets.json
firebase-service-account-*.json

# OS files
Thumbs.db
.DS_Store

# Backups
*.backup
*.bak

# Compiled files
*.class
*.o
*.so

# Certificates
*.pem
*.key
*.cert

# Documentation builds (optional, depending on setup)
site/
docs/_build/

# Operator evidence (optional - may want to commit these)
# evidence/

# AI agent session logs (optional)
# session-logs/
