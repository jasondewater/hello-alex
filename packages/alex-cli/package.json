{
  "name": "@hello-alex/cli",
  "version": "0.1.0",
  "description": "Hello Alex command line interface",
  "type": "module",
  "bin": {
    "alex": "bin/alex.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist", "bin"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "dev": "vitest",
    "lint": "echo 'No lint configured for @hello-alex/cli'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hello-alex/spec": "workspace:*",
    "chalk": "^5.3.0",
    "commander": "^11.0.0",
    "fs-extra": "^11.2.0",
    "inquirer": "^9.2.11",
    "js-yaml": "^4.1.0",
    "ora": "^7.0.1"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/inquirer": "^9.0.7",
    "@types/js-yaml": "^4.0.9"
  }
}
