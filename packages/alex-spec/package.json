{
  "name": "@hello-alex/spec",
  "version": "0.1.0",
  "description": "Specification utilities for Hello Alex",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist", "src/schemas", "examples"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "dev": "vitest",
    "lint": "echo 'No lint configured for @hello-alex/spec'",
    "typecheck": "tsc --noEmit",
    "generate:types": "node ./scripts/generate-types.js"
  },
  "dependencies": {
    "ajv": "^8.12.0",
    "ajv-formats": "^2.1.1",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "json-schema-to-typescript": "^13.1.1"
  }
}
