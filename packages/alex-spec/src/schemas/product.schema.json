{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hello-alex.dev/schemas/alex.product.json",
  "title": "AlexProductSpec",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "metadata", "spec"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^v\\d+\\.\\d+$"
    },
    "metadata": {
      "type": "object",
      "required": ["name", "version"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "spec": {
      "type": "object",
      "required": ["auth", "entities", "flows", "backend"],
      "additionalProperties": false,
      "properties": {
        "auth": {
          "type": "object",
          "required": ["providers"],
          "additionalProperties": false,
          "properties": {
            "providers": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "enum": ["email-password", "google-oauth", "github-oauth"]
              }
            }
          }
        },
        "entities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "fields"],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              },
              "fields": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["name", "type"],
                  "additionalProperties": false,
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "type": {
                      "type": "string",
                      "enum": [
                        "string",
                        "number",
                        "boolean",
                        "date",
                        "datetime",
                        "json"
                      ]
                    },
                    "required": {
                      "type": "boolean",
                      "default": false
                    }
                  }
                }
              }
            }
          }
        },
        "flows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "trigger", "steps"],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "trigger": {
                "type": "string",
                "enum": ["api", "schedule", "user-action"]
              },
              "steps": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["name", "description"],
                  "additionalProperties": false,
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "backend": {
          "type": "object",
          "required": ["adapter", "config"],
          "additionalProperties": false,
          "properties": {
            "adapter": {
              "type": "string",
              "enum": ["firebase", "supabase"]
            },
            "config": {
              "type": "object",
              "additionalProperties": {
                "type": ["string", "number", "boolean"]
              }
            }
          }
        }
      }
    }
  }
}
