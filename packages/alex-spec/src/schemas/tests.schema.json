{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hello-alex.dev/schemas/alex.tests.json",
  "title": "AlexTestsSpec",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "metadata", "spec"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^v\\d+\\.\\d+$"
    },
    "metadata": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "spec": {
      "type": "object",
      "required": ["e2e"],
      "additionalProperties": false,
      "properties": {
        "e2e": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "steps"],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              },
              "steps": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["action", "expectation"],
                  "properties": {
                    "action": { "type": "string" },
                    "expectation": { "type": "string" }
                  }
                }
              }
            }
          }
        },
        "unit": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "coverage": {
              "type": "object",
              "required": ["minimum"],
              "properties": {
                "minimum": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "exclude": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
